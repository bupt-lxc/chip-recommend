# Copy to .env locally. Most entry points require explicit environment loading.
DATA_DB_PATH=data/data.db
HOST=127.0.0.1
PORT=8000
# Optional conversational selection; ordinary queries need no key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Backend extraction/review: root URL; transport appends /v1/chat/completions.
DATA_AGENT_LLM_API_KEY=
DATA_AGENT_LLM_BASE_URL=https://api.moonshot.cn
DATA_AGENT_LLM_MODEL=kimi-k2.6
DATA_AGENT_LLM_TEMPERATURE=0.6
# Empty means use the extraction model in a separate review step.
DATA_AGENT_REVIEW_MODEL=
# Hermes discovery/selection is a separate model channel.
OPENAI_API_KEY=
OPENAI_BASE_URL=
HERMES_MODEL=
HERMES_PROVIDER=
HERMES_CLI_COMMAND=hermes
HERMES_PYTHON=
# Set these optional paths only when known; do not set an empty skill root.
# HERMES_SDK_ROOT=/path/to/hermes-agent
# AISH_PERF_HERMES_SKILL_ROOT=/home/service/.hermes/skills
DOMAIN_SEARCH_BACKEND=html
TAVILY_API_KEY=
DOMAIN_RESULTS_PER_QUERY=5
DOMAIN_MAIN_CANDIDATE_LIMIT=50
AISH_PERF_CONTAINER_DATA_ROOT=/app/data
AISH_PERF_API_CONTAINER=chip-recommend
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1
